{
  "name": "@local/token-stat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: aggregated token usage across all sessions — a pill below the composer plus a 'Token usage' settings page with a daily line chart, a per-model bar chart, and compact tables",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
